# =============================================================================
# Black Timber Contracting — environment variables
# Copy this file to `.env.local` and fill in the real values, then restart
# `npm run dev`. NEVER commit `.env.local`.
# =============================================================================

# ── Supabase (REQUIRED for leads / quotes / admin CRM persistence) ───────────
# Project Settings → API. Use the SECRET (service_role) key on the server only.
# Do NOT use the publishable / anon key here.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Legacy alternative if your project still uses the old key names:
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── OpenRouter (REQUIRED for the AI quote engine + Draw-It-Out mockups) ──────
# Without this the quote wizard falls back to deterministic (non-AI) estimates.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email notifications (OPTIONAL — emails you each new lead via Resend) ─────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Where new-lead notifications are sent (your inbox):
# LEAD_NOTIFICATION_EMAIL=jaryd@blacktimber.ca
# "From" address for outgoing mail. Defaults to jaryd@blacktimber.ca.
# The domain MUST be verified in Resend (Dashboard → Domains) for real sends.
# LEAD_FROM_EMAIL=Jaryd · Black Timber <jaryd@blacktimber.ca>

# ── Slack notifications (OPTIONAL — posts each new lead to a channel) ────────
# SLACK_LEADS_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Admin panel password (REQUIRED to log into /admin) ───────────────────────
ADMIN_PASSWORD=choose-a-strong-password

# ── Local file lead log (OPTIONAL — defaults to ./.data/leads.jsonl) ─────────
# This always runs as a backup sink so a lead is never lost.
# LEAD_LOG_FILE=./.data/leads.jsonl
